SUPABASE_SECRET
SUPABASE_LINK

# Caregiver check-in GPS thresholds — mirror payung_backend/src/monitoring/monitoring.constants.ts
# defaults. Client-side preview only; the checkInBooking/checkOutBooking mutation response is
# always the authoritative source for verdict/flags/distance.
VITE_WARN_RADIUS_M=200
VITE_VERDICT_RADIUS_M=500
VITE_GPS_ACCURACY_TRUST_M=200

# ─── เครื่องมือทดสอบ QR ชั่วคราว (การ์ดแม่ PYG-433) ───────────────────────────
# เปิดปุ่ม "บันทึกรูป QR" ฝั่งผู้รับบริการ + ปุ่ม "อัปโหลดรูป QR" ฝั่งผู้ดูแล
# มีไว้ทดสอบ flow เช็คอิน/เช็คเอาท์ระหว่างที่ scanner กล้อง (PYG-438) ยังไม่เสร็จ
#
#   ไม่ตั้งค่า → เปิดเฉพาะตอน `npm run dev` เท่านั้น (build จริงปิดอัตโนมัติ)
#   true      → เปิด แม้เป็น build จริง (ใช้ตอนทดสอบบน staging)
#   false     → ปิด แม้อยู่ใน dev
#
# ⚠️ ห้ามตั้ง true บน production — รูป QR ที่บันทึกลงเครื่องคือความลับที่กลายเป็นไฟล์
#    ใครได้ไฟล์ไปก็เช็คอิน/เช็คเอาท์งานใบนั้นได้ในช่วงเวลาที่ QR ยังใช้ได้
# เมื่อ PYG-438 เสร็จแล้ว ให้ลบ src/lib/qrTestTools.ts และจุดที่เรียกใช้ทิ้งทั้งหมด
VITE_QR_TEST_TOOLS=

# ─── สมัคร / ล็อกอิน / ผูกเบอร์ด้วยเบอร์โทรศัพท์ (PYG-604) ─────────────────────────
# true → แสดงแท็บเบอร์โทรศัพท์ในหน้า Login และหน้าสมัคร และเมนู "เบอร์โทรศัพท์" ในโปรไฟล์
# ไม่ตั้งค่าหรือค่าอื่น → หน้า Login และหน้าสมัครเหมือนเดิมทุกอย่าง
#
# ⚠️ เปิดได้เมื่อ BE (PYG-603) deploy operation ของเบอร์โทรแล้วเท่านั้น
#    ถ้าเปิดก่อน แท็บเบอร์โทรจะเป็นค่าเริ่มต้นแต่กดแล้ว error ทุกครั้ง
VITE_PHONE_AUTH_ENABLED=
